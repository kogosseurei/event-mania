# Cloudinary cloud name; optional in development
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Cloudinary seed script credentials only
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google AI Studio key; optional, server only
GEMINI_API_KEY=
# Configurable fast and smart model identifiers
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
# Public canonical application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Running MCP endpoint for integration tests
MCP_URL=http://localhost:3000/api/mcp# Optional external Playwright target; otherwise a local production server is started
BASE_URL=
# Optional CI-only protection bypass for Vercel previews; never public
VERCEL_AUTOMATION_BYPASS_SECRET=
